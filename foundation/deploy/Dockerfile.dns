FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/mallin
COPY foundation/dns/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY foundation/dns/server.py ./server.py
COPY foundation/dns/zones.example.json ./zones.example.json
ENV MALLIN_DNS_HOST=0.0.0.0
ENV MALLIN_DNS_PORT=53
ENV MALLIN_DNS_ZONE_FILE=/opt/mallin/zones.example.json
EXPOSE 53/udp 53/tcp
USER 65532:65532
CMD ["python", "/opt/mallin/server.py"]
